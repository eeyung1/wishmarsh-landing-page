{
  "name": "wishmarsh-landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Wishmarsh — landing page. Share wishes. Create memories.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild main.ts --bundle --outfile=main.js --format=iife --target=es2019 --sourcemap --legal-comments=none",
    "build:min": "npm run typecheck && esbuild main.ts --bundle --outfile=main.js --format=iife --target=es2019 --minify --legal-comments=none",
    "watch": "esbuild main.ts --bundle --outfile=main.js --format=iife --target=es2019 --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run bundle && npm run serve",
    "clean": "node -e \"const fs=require('fs');for(const f of ['main.js','main.js.map'])fs.rmSync(f,{force:true})\""
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
